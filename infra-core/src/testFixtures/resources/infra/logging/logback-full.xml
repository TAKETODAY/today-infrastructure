<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <contextName>TODAY Framework Full Log</contextName>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>
        %red(%d{yyyy-MM-dd HH:mm:ss.SSS}) %highlight(%-5level) - %blue([%16.16t]) %cyan(%-40.40logger{40}) %4.4L - %m%n
      </pattern>
    </encoder>
  </appender>

  <!--
    Shared configuration used when the FULL_LOG test group is active
    (-PtestGroups=FULL_LOG). It is selected via the logback.configurationFile
    system property set by TestConventions, so every module test JVM that uses
    logback starts with the root logger at TRACE.
  -->
  <root level="TRACE">
    <appender-ref ref="STDOUT" />
  </root>

</configuration>
